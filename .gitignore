__pycache__/
# Native `.pyd` files are generated PyInstaller runtime artifacts too. Release
# ZIPs must be assembled with `source/package_release.ps1`, not `git archive`.
*.py[cod]
# The checked-in root portable bundle intentionally carries its complete
# native runtime. Keep those extension modules versioned; build outputs under
# source/dist/ remain ignored by the source-level ignore file.
!_internal/**/*.pyd
!_internal/**/*.pyc
Thumbs.db
Desktop.ini
*.db
*.sqlite
*.sqlite3
*.log
launcher_error.log
logs/
build/
.build_env/
source/__pycache__/
source/.build_env*/
source/.build_tmp/
source/build/
source/dist/
source/release/
source/*.log
matplotlib_cache/
runtime_plot_test.*
ProgTrackData/
.windsurf/
ProgTrack.v.0.1.0.zip
progtrack_daten.lock
tests/
tmp/
outputs/
.pytest_cache/
.ruff_cache/
Depricated.md
*.bak
Plugins/Projects_Track/project_assignment_cache/
# Legacy document folders are not runtime stores; documents are managed by the
# configured backend and must not be reintroduced into the application bundle.
Plugins/Projects_Track/documents/
Plugins/Projects_Track/sop/
Plugins/Medi_Track/medi_track/
Plugins/Master_Track/sessions/*.json
