{
  "name": "Master_Track",
  "display_name": "Master Track",
  "version": "0.2.1",
  "description": "Authentication, user roles, job bundles, direct permissions, per-user sessions, and audit logging for ProgTrack. Supports Lord, Master, User, and Guest access levels with configurable job-based permission bundles.",
  "author": "DLL",
  "SPDX-License-Identifier": "GPL-3.0-or-later",
