  "entry_point": "plugin.MasterTrackPlugin",
  "dependencies": [
    "PyQt6"
  ],
  "data_files": [
    "permissions_labels.json"
  ],
  "min_progtrack_version": "0.2.1",
  "menu_location": "Tools",
  "icon": "progtrack_icon.ico",
  "optional": false,
  "features": [
    "authentication",
    "lord_master_user_guest_roles",
    "job_bundle_permissions",
    "direct_permission_overrides",
    "user_profile_management",
    "per_user_session_persistence",
    "audit_logging",
    "audit_log_review_and_export"
  ],
  "bootstrap_entry_point": "__init__.initialize",
  "capabilities": [
    "authentication",
    "lord_master_user_guest_roles",
    "job_bundle_permissions",
    "direct_permission_overrides",
    "user_profile_management",
    "per_user_session_persistence",
    "audit_logging",
    "audit_log_review_and_export"
  ],
  "permissions": [],
  "backend_namespaces": [],
  "resources": [
    "permissions_labels.json"
  ],
  "docs": [
    "../../manual/ProgTrack_User_Guide - en.html#plugins"
  ]
}
