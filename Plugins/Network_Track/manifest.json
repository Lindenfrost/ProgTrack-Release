{
  "name": "Network_Track",
  "display_name": "Network Track",
  "version": "0.2.1",
  "description": "Lightweight multi-user chat system for team communication within a shared ProgTrack data directory. Messages are stored in a shared text file with automatic polling, notification sounds, and configurable display settings.",
