  "dependencies": [
    "PyQt6"
  ],
  "data_files": [
    "notification.wav"
  ],
  "min_progtrack_version": "0.2.1",
  "menu_location": "Tools",
  "icon": "progtrack_icon.ico",
  "optional": true,
  "features": [
    "shared_file_team_chat",
    "multi_user_message_log",
    "automatic_polling",
    "notification_sounds",
    "display_settings",
    "master_track_identity_integration"
  ],
  "capabilities": [
    "shared_file_team_chat",
    "multi_user_message_log",
