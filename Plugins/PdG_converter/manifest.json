{
  "name": "PdG_converter",
  "display_name": "PdG to Progesterone Converter",
  "version": "0.2.1",
  "description": "Converts urine PdG (pregnanediol glucuronide) measurements to progesterone equivalents using fitted mathematical models. Supports kink (broken-stick) and linear models with bounded least squares fitting. Features individual per-animal parameter storage and optional plugin architecture.",
  "author": "DLL",
  "SPDX-License-Identifier": "GPL-3.0-or-later",
  "Copyright": "Copyright © 2026 Dimitri L. Lindenwald and Deutsches Primatenzentrum GmbH",
  "entry_point": "plugin.PdGConverterPlugin",
  "dependencies": [
    "PyQt6",
    "numpy",
    "scipy"
  ],
  "data_files": [
    "data/*.json"
  ],
  "min_progtrack_version": "0.2.1",
  "menu_location": "Tools",
  "icon": "progtrack_icon.ico",
  "optional": true,
  "features": [
    "pdg_to_progesterone_conversion",
    "per_animal_model_parameters",
    "linear_model_fitting",
    "kink_model_fitting",
    "converted_progesterone_overlay",
    "pdg_measurement_table_integration"
  ],
  "capabilities": [
    "pdg_to_progesterone_conversion",
    "per_animal_model_parameters",
    "linear_model_fitting",
    "kink_model_fitting",
    "converted_progesterone_overlay",
    "pdg_measurement_table_integration"
  ],
  "permissions": [],
  "backend_namespaces": [],
  "resources": [
    "data/*.json"
  ],
  "docs": [
    "../../manual/ProgTrack_User_Guide - en.html#plugins"
  ]
}
